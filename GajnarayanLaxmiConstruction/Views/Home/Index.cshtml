                        </tr>
                        <tr>
                            <td class="reg-no mono">GL-23</td>
                            <td class="reg-name">Navkar Business Hub</td>
                            <td class="reg-loc">S.G. Highway</td>
                            <td class="reg-loc">Commercial — office shell</td>
                            <td><span class="reg-status done">Handed over</span></td>
                        </tr>
                        <tr>
                            <td class="reg-no mono">GL-22</td>
                            <td class="reg-name">Patel Bungalow Extension</td>
                            <td class="reg-loc">Naranpura</td>
                            <td class="reg-loc">Residential — renovation</td>
                            <td><span class="reg-status done">Handed over</span></td>
                        </tr>
                        <tr>
                            <td class="reg-no mono">GL-25</td>
                            <td class="reg-name">Om Industrial Shed</td>
                            <td class="reg-loc">Vatva GIDC</td>
                            <td class="reg-loc">Industrial — warehouse</td>
                            <td><span class="reg-status progress">In progress</span></td>
                        </tr>
                        <tr>
                            <td class="reg-no mono">GL-26</td>
                            <td class="reg-name">Laxmi Enclave Row Houses</td>
                            <td class="reg-loc">South Bopal</td>
                            <td class="reg-loc">Residential — row houses (6 units)</td>
                            <td><span class="reg-status progress">In progress</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section id="about">
            <div class="wrap about-grid reveal">
                <div class="about-copy">
                    <h2 style="margin-bottom:18px; font-size:clamp(1.5rem,2.4vw,2rem);">Built on-site, not on paper</h2>
                    <p>Gajnarayan Laxmi Construction runs its own labour teams and site supervisors, rather than subcontracting the actual construction. That means one point of contact for the client, and one team accountable for the quality of the final structure.</p>
                    <p>We work across residential, commercial and industrial jobs in and around Ahmedabad, and take on projects from a single-unit renovation to a multi-unit residential development.</p>
                </div>
                <div class="about-figures">
                    <div class="fig-row"><span class="k">Founded</span><span class="v">Add year</span></div>
                    <div class="fig-row"><span class="k">Registered office</span><span class="v">Ahmedabad, Gujarat</span></div>
                    <div class="fig-row"><span class="k">Active site teams</span><span class="v">6</span></div>
                    <div class="fig-row"><span class="k">Typical project size</span><span class="v">1–40 units</span></div>
                    <div class="fig-row"><span class="k">Licences &amp; registration</span><span class="v">Add GST / contractor licence no.</span></div>
                </div>
            </div>
        </section>

        <section class="contact" id="contact">
            <div class="wrap contact-grid reveal">
                <div class="contact-info">
                    <h2 style="margin-bottom:24px; font-size:clamp(1.5rem,2.4vw,2rem);">Talk to us about your site</h2>
                    <dl>
                        <div class="item">
                            <dt>Phone</dt>
                            <dd><a href="tel:+919800000000">+91 98000 00000</a></dd>
                        </div>
                        <div class="item">
                            <dt>Email</dt>
                            <dd><a href="mailto:info@gajnarayanlaxmi.com">info@gajnarayanlaxmi.com</a></dd>
                        </div>
                        <div class="item">
                            <dt>Office</dt>
                            <dd>Add your office address, Ahmedabad, Gujarat</dd>
                        </div>
                        <div class="item">
                            <dt>Site hours</dt>
                            <dd>Monday–Saturday, 9:00 AM–7:00 PM</dd>
                        </div>
                    </dl>
                </div>
                <form id="quoteForm" novalidate>
                    <div class="form-row">
                        <div>
                            <label for="name">Your name<span class="req">*</span></label>
                            <input id="name" name="name" type="text" required minlength="2" autocomplete="name">
                        </div>
                        <div>
                            <label for="phone">Phone number<span class="req">*</span></label>
                            <input id="phone" name="phone" type="tel" required autocomplete="tel">
                        </div>
                    </div>
                    <div class="form-row">
                        <div>
                            <label for="type">Type of project</label>
                            <select id="type" name="type">
                                <option>Residential construction</option>
                                <option>Commercial / industrial</option>
                                <option>Interior fit-out</option>
                                <option>Renovation / repair</option>
                                <option>Civil / site work</option>
                                <option>Not sure yet</option>
                            </select>
                        </div>
                        <div>
                            <label for="location">Site location</label>
                            <input id="location" name="location" type="text" placeholder="Area, city">
                        </div>
                    </div>
                    <div>
                        <label for="details">Tell us about the site</label>
                        <textarea id="details" name="details" placeholder="Plot size, current stage, rough timeline..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-solid" style="justify-self:start;">Send via WhatsApp</button>
                    <p class="form-note">Opens WhatsApp with your message pre-filled — nothing is stored or sent by the site itself.</p>
                    <p id="form-status" role="status"></p>
                </form>
            </div>
        </section>

    </main>

    <footer>
        <div class="wrap">
            <div class="foot-grid">
                <div>
                    <div class="foot-brand">Gajnarayan Laxmi Construction</div>
                    <p class="foot-tag">Residential, commercial and industrial construction across Ahmedabad — from first survey to final handover.</p>
                </div>
                <div class="foot-col">
                    <h4>Site</h4>
                    <a href="#services">Services</a>
                    <a href="#process">How we build</a>
                    <a href="#projects">Projects</a>
                    <a href="#about">About</a>
                </div>
                <div class="foot-col">
                    <h4>Reach us</h4>
                    <a href="tel:+919800000000">+91 98000 00000</a>
                    <a href="mailto:info@gajnarayanlaxmi.com">info@gajnarayanlaxmi.com</a>
                    <a href="#contact">Site enquiry form</a>
                </div>
            </div>
            <div class="foot-bottom">
                <span>© <span id="year"></span> Gajnarayan Laxmi Construction</span>
                <span>Ahmedabad, Gujarat</span>
            </div>
        </div>
    </footer>

    <a href="#" id="waFloat" class="wa-float" aria-label="Chat with us on WhatsApp" target="_blank" rel="noopener">
