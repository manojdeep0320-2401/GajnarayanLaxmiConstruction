                    <path d="M8 30V16L20 8L32 16V30" stroke="#2C4A66" stroke-width="1.6" />
                    <path d="M8 30H32" stroke="#211D18" stroke-width="1.6" />
                    <circle cx="20" cy="21" r="3.4" stroke="#A97A24" stroke-width="1.4" />
                </svg>
                <span class="brand-name">Gajnarayan Laxmi<small>Construction &amp; Contracting</small></span>
            </a>
            <nav class="links">
                <a href="#services">Services</a>
                <a href="#process">How we build</a>
                <a href="#gallery">Gallery</a>
                <a href="#projects">Projects</a>
                <a href="#about">About</a>
                <a href="#contact">Contact</a>
