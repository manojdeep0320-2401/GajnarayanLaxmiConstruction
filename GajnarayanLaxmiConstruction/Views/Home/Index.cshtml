            <path d="M4 20L5.3 15.6C4.5 14.2 4 12.6 4 11C4 6.6 7.8 3 12.4 3C17 3 20.8 6.6 20.8 11C20.8 15.4 17 19 12.4 19C10.9 19 9.5 18.6 8.3 17.9L4 20Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
